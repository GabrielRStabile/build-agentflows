    "@modelcontextprotocol/sdk": "1.30.0",
    "@modelcontextprotocol/server-postgres": "0.6.2",
    "@openai/codex": "0.155.1",
    "@xyflow/react": "^12.11.6",
    "cheerio": "^1.2.0",
    "csv-parse": "^7.0.2",
    "drizzle-orm": "^0.45.3",
    "faiss-node": "0.5.1",
    "jose": "^6.2.12",
    "mongodb": "7.6.0",
    "mysql2": "3.24.4",
    "next": "16.3.5",
    "officeparser": "^8.0.0",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "redis": "^6.2.1",
    "remark-gfm": "4.0.1",
    "sharp": "0.35.4",
    "undici": "^8.11.2",
    "unpdf": "1.8.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.2",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
