{
  "name": "build-agentflows",
  "version": "0.42.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --ignore-pattern \"data/**\"",
    "test": "node --import ./scripts/gancho-ts.mjs --test --test-concurrency=4 lib/*.test.ts",
    "test:saas": "node --import ./scripts/gancho-ts.mjs --test lib/saas-*.test.ts",
    "test:redis": "node --import ./scripts/gancho-ts.mjs scripts/test-redis-queue.mjs",
    "test:postgres": "node scripts/test-postgres.mjs",
    "test:docker": "node scripts/test-docker.mjs",
    "db:migrate": "node --import ./scripts/gancho-ts.mjs scripts/migrate-saas.mjs",
    "db:generate": "drizzle-kit generate",
    "worker": "node --import ./scripts/gancho-ts.mjs scripts/worker.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1140.0",
    "@brave/brave-search-mcp-server": "2.1.4",
